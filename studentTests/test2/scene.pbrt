# test2 - WSRT: dielectric transmission.
# A glass sphere on a matte floor. Fresnel must split each ray between the
# reflection and the refraction branch, and rays that exceed the critical angle
# must be totally internally reflected instead of escaping. The background is
# deliberately brighter than the floor so the refracted image is visible
# through the glass.

Integrator "whitted" { "integer maxdepth" 12 }
Film "film" { "integer xresolution" 240 "integer yresolution" 180 }
Camera "camera" { "lookat" 0 1.6 6.5  0 1.1 0  0 1 0  "float fov" 38 }

Material "floor" { "diffuse" "reflectance" [ 0.55 0.57 0.60 ] }
Material "glass" { "dielectric" "eta" 1.52 "reflectance" [ 1 1 1 ] }
Material "backdrop" { "diffuse" "reflectance" [ 0.85 0.86 0.88 ] }

Shape "ground" { "plane" [ 0 0 0 ] "rotate" 1 0 0 -90  "material" "floor" }
Shape "wall"  { "plane" [ 0 0 -3.2 ] "material" "backdrop" }
Shape "orb"   { "sphere" [ 1.15 ] "translate" 0 1.15 0  "material" "glass" }

Light "key" { "point" [ -3.0 5.0 5.0 ] "radiantintensity" [ 55 54 52 ] }
Light "rim" { "point" [ 3.5 2.5 -1.5 ] "radiantintensity" [ 18 18 20 ] }
