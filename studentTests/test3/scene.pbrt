# test3 - WSRT: PPM textures on a sphere and a plane.
# checker.ppm is an 8x8 checkerboard of 64x64 pixels written in plain binary PPM
# (P6), stored next to this scene file. The same image is mapped onto the floor
# with a scaled UV and onto the sphere with spherical UVs, so a broken UV
# parameterisation is immediately visible as a smeared or collapsed pattern.

Integrator "whitted" { "integer maxdepth" 6 }
Film "film" { "integer xresolution" 240 "integer yresolution" 180 }
Camera "camera" { "lookat" 0 2.0 6.0  0 1.1 0  0 1 0  "float fov" 40 }

Material "tiled" {
  "diffuse"
  "texture" "diffuse" "checker.ppm"
  "float uscale" 6 "float vscale" 6
}
Material "glossy" {
  "diffuse"
  "texture" "diffuse" "checker.ppm"
  "float uscale" 2 "float vscale" 1
  "specularreflectance" [ 0.35 0.35 0.35 ]
  "float shininess" 60
}

Shape "ground" { "plane" [ 0 0 0 ] "rotate" 1 0 0 -90  "material" "tiled" }
Shape "ball"  { "sphere" [ 1.2 ] "translate" 0 1.2 -0.4  "material" "glossy" }

Light "key" { "point" [ -4.0 5.5 3.5 ] "radiantintensity" [ 60 58 55 ] }
Light "fill" { "point" [ 4.5 2.5 2.0 ] "radiantintensity" [ 14 14 16 ] }
