# test8 - Parser robustness: unsupported features and syntax errors.
# This scene is deliberately broken. The renderer must not crash and must not
# fail silently: every problem has to be reported in the log with a descriptive
# message. run.sh checks that
#   * the process exits cleanly (exit status 0, no crash / signal),
#   * the log contains at least one ERROR for the unknown material type,
#   * the log contains at least one ERROR for the unknown integrator type,
#   * the log contains at least one ERROR for the malformed attribute list
#     (the light is missing its closing bracket),
#   * the summary line reports a non-zero parse error count.
# The renderer is expected to keep going with its defaults for the parts it
# could not understand, and to still write an image.

Integrator "quantumraytracer" { "integer maxdepth" 4 }
Film "film" { "integer xresolution" 120 "integer yresolution" 90 }
Camera "camera" { "lookat" 0 2.0 6.0  0 1.0 0  0 1 0  "float fov" 40 }

Material "unobtainium" { "hypermetallic" "reflectance" [ 0.5 0.5 0.5 ] }
Material "floor" { "diffuse" "reflectance" [ 0.7 0.7 0.7 ] }

Shape "ground" { "plane" [ 0 0 0 ] "rotate" 1 0 0 -90  "material" "floor" }
Shape "ball" { "sphere" [ 1.0 ] "translate" 0 1.0 0  "material" "floor" }

# Missing closing bracket and an out-of-range number.
Light "broken" { "point" [ 0 5 4 "radiantintensity" [ 30 30 30 ]
