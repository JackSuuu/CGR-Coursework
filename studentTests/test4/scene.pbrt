# test4 - BVH equivalence.
# The same scene is rendered twice by run.sh, once with the BVH enabled (the
# default) and once with --no-bvh, which falls back to a linear scan over every
# primitive. Both runs must trace identical primary and shadow rays, so the
# image statistics have to match to within a very small tolerance. The scene
# deliberately mixes a plane, spheres and triangles so the primitive set is not
# uniform.

Integrator "whitted" { "integer maxdepth" 6 }
Film "film" { "integer xresolution" 200 "integer yresolution" 150 }
Camera "camera" { "lookat" 0 2.4 8.0  0 1.0 0  0 1 0  "float fov" 40 }

Material "floor" { "diffuse" "reflectance" [ 0.70 0.70 0.72 ] }
Material "tri"   { "diffuse" "reflectance" [ 0.75 0.35 0.25 ] }
Material "metal" { "mirror" "reflectance" [ 0.9 0.9 0.9 ] }
Material "blue"  { "diffuse" "reflectance" [ 0.20 0.35 0.75 ] }

Shape "ground" { "plane" [ 0 0 0 ] "rotate" 1 0 0 -90  "material" "floor" }
Shape "a" { "sphere" [ 0.9 ] "translate" -1.8 0.9 0.5  "material" "metal" }
Shape "b" { "sphere" [ 0.7 ] "translate" 2.0 0.7 -0.6  "material" "blue" }
Shape "c" { "sphere" [ 0.5 ] "translate" 0.4 3.4 1.2  "material" "blue" }
Shape "t1" { "triangle" [ -3.0 0.02 2.5  -0.5 0.02 3.4  -2.0 2.20 2.8 ]  "material" "tri" }
Shape "t2" { "triangle" [ -0.5 0.02 3.4   2.2 0.02 2.9   0.6 1.70 3.2 ]  "material" "tri" }

Light "key" { "point" [ -4.0 6.0 5.0 ] "radiantintensity" [ 70 68 64 ] }
