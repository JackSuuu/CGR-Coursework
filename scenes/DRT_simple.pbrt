# DRT_simple -- every Module 1 DRT feature in one image.
#
# Features on show:
#   1. triangle mesh loaded from an .obj file, with per-face normals
#   2. area (rectangle) light, sampled uniformly -> soft shadows
#   3. Phong BRDF with a coloured specular lobe
#   4. thin-lens depth of field (the lens sample drives both the aperture and
#      the light-surface sample)
#   5. per-channel Reinhard tone mapping on the HDR result
#   6. diffuse texture lookup with u/v scaling
#   7. a diffuse sphere and a plane, so global illumination and shadows on
#      curved and flat geometry can be compared

Integrator "distributed" {
    "integer maxdepth" 4      # MD: maximum ray-tree depth
    "integer bf" 4            # rays generated per scattering event
    "integer spp" 16          # pixel filter samples per pixel
    "string sampler" "grid"
}

Film "drtSimple" {
    "integer xresolution" 900
    "integer yresolution" 600
}

# The aperture is non-zero, so this is a thin-lens camera focused on the mesh.
Camera "cam" {
    "lookat" 0 1.9 7.5    0 1.15 0   0 1 0
    "float fov" 36
    "float apertureradius" 0.035
    "float focusdistance" 7.2
}

# ---- materials ---------------------------------------------------------
Material "floorMat" {
    "phong" "reflectance" [ 0.72 0.70 0.66 ] "specularreflectance" [ 0.10 0.10 0.10 ] "float phong" 30
    "texture" "diffuse" "textures/checker.ppm"
    "float uscale" 6
    "float vscale" 6
}
Material "meshMat" {
    # 3. Phong with a warm specular lobe, so the highlight reads clearly.
    "phong" "reflectance" [ 0.55 0.30 0.22 ] "specularreflectance" [ 0.9 0.75 0.5 ] "float phong" 70
}
Material "ballMat" {
    "phong" "reflectance" [ 0.15 0.45 0.70 ] "specularreflectance" [ 0.8 0.8 0.8 ] "float phong" 120
}

# ---- geometry ----------------------------------------------------------
Shape "ground" {
    "plane" [ 0 0 0 ]
    "rotate" 1 0 0 -90
    "material" "floorMat"
}

# 1. A 5120-triangle geodesic sphere read from disk.
Shape "ico" {
    "trianglemesh" "meshes/icosphere.obj"
    "translate" -0.15 1.05 0
    "scale" 1.05 1.05 1.05
    "material" "meshMat"
}

Shape "ball" {
    "sphere" [ 0.95 ]
    "translate" 2.6 0.95 0.6
    "material" "ballMat"
}

# ---- lights ------------------------------------------------------------
# 2. An emissive rectangle. Because the DRT samples a point on it per bounce,
# the penumbra under the mesh and the ball is soft.
Light "softbox" {
    "rectangle" [ -3.0 5.2 3.2   3.0 5.2 3.2 ]
    "radiance" [ 26 24 21 ]
}
Light "bounce" {
    "rectangle" [ 3.6 1.1 3.4   3.6 3.4 3.4 ]
    "rotate" 0 0 1 -90
    "radiance" [ 4 6 10 ]
}
