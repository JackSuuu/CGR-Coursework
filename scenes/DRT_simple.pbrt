# DRT_simple -- every Module 1 DRT feature in one image.
#
# Features on show:
#   1. triangle mesh loaded from an .obj file, with interpolated vertex normals
#   2. area (rectangle) light, sampled uniformly -> soft shadows
#   3. Phong BRDF with a coloured specular lobe
#   4. thin-lens depth of field (independent aperture and light samples)
#   5. per-channel Reinhard tone mapping on the HDR result
#   6. diffuse texture lookup with u/v scaling
#   7. a diffuse sphere and a plane, so direct illumination and shadows on
#      curved and flat geometry can be compared

Integrator "distributed" {
    "integer maxdepth" 4      # MD: maximum ray-tree depth
    "integer spp" 32         # lens/light samples per pixel, fixed pixel centre
    "float whitepoint" 8
}

Film "drtSimple" {
    "integer xresolution" 600
    "integer yresolution" 400
}

# The aperture is non-zero, so this is a thin-lens camera focused on the mesh.
Camera "cam" {
    "lookat" 0.9 2.4 9.0    0.9 1.0 0   0 1 0
    "float fov" 46
    "float apertureradius" 0.18
    "float focusdistance" 9.0
}

# ---- materials ---------------------------------------------------------
Material "floorMat" {
    "phong" "reflectance" [ 0.72 0.70 0.66 ] "specularreflectance" [ 0.10 0.10 0.10 ] "float phong" 30
    "texture" "diffuse" "textures/wood.ppm"
    "float uscale" 0.5
    "float vscale" 0.5
}
Material "meshMat" {
    # A broad blue/cream UV pattern and a moderate Phong lobe.
    "phong" "reflectance" [ 0.90 0.90 0.90 ] "specularreflectance" [ 0.12 0.12 0.12 ] "float phong" 40
    "texture" "diffuse" "textures/broad_checker.ppm"
}
Material "ballMat" {
    "phong" "reflectance" [ 0.15 0.45 0.70 ] "specularreflectance" [ 0.35 0.35 0.35 ] "float phong" 60
}
Material "foregroundMat" { "phong" "reflectance" [ 0.75 0.17 0.08 ] "specularreflectance" [ 0.2 0.2 0.2 ] "float phong" 45 }
Material "backMat" { "phong" "reflectance" [ 0.35 0.42 0.48 ] "specularreflectance" [ 0.02 0.02 0.02 ] "float phong" 15 }

# ---- geometry ----------------------------------------------------------
Shape "ground" {
    "plane" [ 0 0 0 ]
    "rotate" 1 0 0 -90
    "material" "floorMat"
}

# 1. An OBJ geodesic sphere with smooth vertex normals and texture UVs.
Shape "ico" {
    "trianglemesh" "meshes/uv_geodesic.obj"
    "translate" -0.15 1.05 0
    "scale" 1.05 1.05 1.05
    "material" "meshMat"
}
Shape "backWall" { "plane" [ 0 0 0 ] "translate" 0 0 -5 "material" "backMat" }
# A foreground object lies well in front of the mesh's focal plane.
Shape "foreground" { "sphere" [ 0.42 ] "translate" -0.7 0.42 3.0 "material" "foregroundMat" }
# The planar checker faces provide a second, easily identifiable OBJ UV example.
Shape "checkerBlock" { "trianglemesh" "meshes/display_box.obj" "translate" 2.3 0 -2.3 "scale" 1.15 1.75 1.15 "material" "meshMat" }

Shape "ball" {
    "sphere" [ 0.95 ]
    "translate" 2.6 0.95 0.6
    "material" "ballMat"
}

# ---- lights ------------------------------------------------------------
# 2. An emissive rectangle. Because the DRT samples a point on it per bounce,
# the penumbra under the mesh and the ball is soft.
Light "softbox" {
    "rectangle" [ -3.0 5.2 -1.0   3.0 5.2 -1.0   3.0 5.2 3.2   -3.0 5.2 3.2 ]
    "radiance" [ 10 9.5 8.5 ]
}
Light "bounce" {
    "rectangle" [ 4.5 1.1 -0.5   4.5 3.4 -0.5   4.5 3.4 2.0   4.5 1.1 2.0 ]
    "radiance" [ 2.5 4 7 ]
}
