# WSRT_creative -- the WSRT pushed a bit further than WSRT_simple.
# Provisional tabletop optics still life; the student must provide a real
# inspiration photograph and adapt/justify the arrangement before submission.
#
# Features available for the student's own image annotations:
#   1. a textured diffuse floor with hard shadows
#   2. Fresnel reflection/refraction through a closed, elongated glass object
#   3. multiple nested mirrors (the two chrome spheres reflect each other)
#   4. two point lights with different colours -> coloured lighting/highlights
#   5. UV texture mapping on the diffuse floor
#   6. shadow rays through the "arch" of triangles
#   7. recursive mirror-in-mirror paths, bounded by maxdepth

Integrator "whitted" {
    "integer maxdepth" 12
}

Film "creative" {
    "integer xresolution" 960
    "integer yresolution" 600
}

Camera "cam" {
    "lookat" 0 2.2 11.0   0 1.4 0   0 1 0
    "float fov" 48
}

# ---- materials ---------------------------------------------------------
Material "marble" {
    "diffuse" "reflectance" [ 0.85 0.83 0.80 ]
    "texture" "diffuse" "textures/wood.ppm"
    "float uscale" 0.6
    "float vscale" 0.6
}
Material "chromeA" {
    "mirror" "reflectance" [ 1.0 0.97 0.92 ]
}
Material "chromeB" {
    "mirror" "reflectance" [ 0.90 0.93 1.00 ]
}
Material "glassSlab" {
    "dielectric" "reflectance" [ 1 1 1 ] "float eta" 1.60
}
Material "rubyBall" {
    "phong" "reflectance" [ 0.70 0.05 0.08 ] "specularreflectance" [ 1.0 0.9 0.9 ] "float phong" 90
}
Material "goldBall" {
    "blinnphong" "reflectance" [ 0.85 0.65 0.20 ] "specularreflectance" [ 1 1 1 ] "float shininess" 220
}
Material "tealBall" {
    "blinnphong" "reflectance" [ 0.10 0.45 0.48 ] "specularreflectance" [ 0.6 0.7 0.7 ] "float shininess" 70
}
Material "arch" {
    "blinnphong" "reflectance" [ 0.55 0.55 0.60 ] "specularreflectance" [ 0.3 0.3 0.3 ] "float shininess" 25
}
Material "paper" { "blinnphong" "reflectance" [ 0.9 0.85 0.72 ] "specularreflectance" [ 0.02 0.02 0.02 ] "shininess" 15 "texture" "diffuse" "textures/paper.ppm" }
Material "bookCover" { "blinnphong" "reflectance" [ 0.12 0.24 0.38 ] "specularreflectance" [ 0.15 0.15 0.15 ] "shininess" 35 }
Material "backdrop" { "diffuse" "reflectance" [ 0.16 0.22 0.28 ] }

# ---- geometry ----------------------------------------------------------
# Marble floor. pbrt planes are xy with normal +z, so rotate -90 about x.
Shape "floor" {
    "plane" [ 0 0 0 ]
    "rotate" 1 0 0 -90
    "material" "marble"
}
Shape "backdrop" { "plane" [ 0 0 0 ] "translate" 0 0 -6 "material" "backdrop" }
Shape "bookPages" { "trianglemesh" "meshes/display_box.obj" "translate" 1.1 0.04 -2.4 "scale" 2.15 0.30 1.45 "material" "paper" }
Shape "bookBottom" { "trianglemesh" "meshes/display_box.obj" "translate" 1.1 0 -2.4 "scale" 2.30 0.04 1.60 "material" "bookCover" }
Shape "bookTop" { "trianglemesh" "meshes/display_box.obj" "translate" 1.1 0.34 -2.4 "scale" 2.30 0.04 1.60 "material" "bookCover" }

# 1/2. Two chrome balls facing each other: each shows the other, which is what
# makes the recursion visible. The glass between them refracts the background.
Shape "chromeLeft" {
    "sphere" [ 1.15 ]
    "translate" -2.5 1.15 1.0
    "material" "chromeA"
}
Shape "chromeRight" {
    "sphere" [ 1.15 ]
    "translate" 2.5 1.15 -1.0
    "material" "chromeB"
}

# Closed dielectric geometry has a well-defined entry and exit surface.
Shape "slab" {
    "sphere" [ 0.75 ]
    "translate" 0 1.35 2.0
    "scale" 0.6 1.8 0.8
    "material" "glassSlab"
}

# Coloured surfaces with Blinn-Phong highlights in the WSRT.
Shape "ruby" {
    "sphere" [ 0.85 ]
    "translate" -0.9 0.85 -2.4
    "material" "rubyBall"
}
Shape "gold" {
    "sphere" [ 0.85 ]
    "translate" 1.1 1.23 -2.4
    "material" "goldBall"
}
Shape "teal" {
    "sphere" [ 0.55 ]
    "translate" -3.6 0.55 -1.6
    "material" "tealBall"
}

# 6. An arch of four triangles; the key light passes through the opening and
# casts a shaped patch on the floor behind it.
Shape "archL" {
    "triangle" [ -4.6 0 -1.2   -4.6 2.6 -1.2   -3.9 2.6 -1.2 ]
    "material" "arch"
}
Shape "archR" {
    "triangle" [ -3.3 0 -1.2   -3.3 2.6 -1.2   -4.0 2.6 -1.2 ]
    "material" "arch"
}
Shape "archTop" {
    "triangle" [ -4.6 2.6 -1.2   -4.6 3.2 -1.2   -3.3 3.2 -1.2 ]
    "material" "arch"
}

# ---- lights ------------------------------------------------------------
# 4. A warm key and a cool fill. The WSRT traces one shadow ray per light, so
# the two shadows stay hard-edged; area-light soft shadows are a DRT feature.
Light "key" {
    "point" [ -5.0 7.0 6.0 ]
    "intensity" [ 150 130 105 ]
}
Light "fill" {
    "point" [ 5.5 3.5 4.5 ]
    "intensity" [ 45 55 80 ]
}
