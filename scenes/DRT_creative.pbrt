# DRT_creative -- the DRT pushed a bit further than DRT_simple.
#
# Extra features on show:
#   1. three area lights of different sizes: penumbra width tracks light size,
#      which is the clearest evidence that the light is really being sampled
#   2. two meshes at different scales, one reflective, one rough
#   3. a mirror ball next to rough surfaces, so the delta/rough split shows
#   4. thin lens focused on the *back* object, so the front mesh is defocused
#   5. a bright emissive panel acting as the main source (visible in mirrors)
#   6. colour bleeding onto the white floor from the coloured objects
#   7. per-channel Reinhard on a scene whose dynamic range is deliberately wide

Integrator "distributed" {
    "integer maxdepth" 6
    "integer bf" 4
    "integer spp" 8
}

Film "drtCreative" {
    "integer xresolution" 360
    "integer yresolution" 240
}

Camera "cam" {
    "lookat" 0 1.6 8.5    0 1.3 -1.5   0 1 0
    "float fov" 40
    # 4. Focus is pulled to the far object, so the near mesh goes soft.
    "float apertureradius" 0.10
    "float focusdistance" 10.5
}

# ---- materials ---------------------------------------------------------
Material "whiteFloor" {
    # 6. Near-white diffuse so colour bleeding is easy to see.
    "phong" "reflectance" [ 0.90 0.90 0.88 ] "specularreflectance" [ 0.04 0.04 0.04 ] "float phong" 20
}
Material "stone" {
    "phong" "reflectance" [ 0.48 0.47 0.44 ] "specularreflectance" [ 0.18 0.18 0.18 ] "float phong" 25
    "texture" "diffuse" "textures/checker.ppm"
    "float uscale" 2
    "float vscale" 2
}
Material "redMetal" {
    "mirror" "reflectance" [ 0.85 0.25 0.20 ]
}
Material "greenPhong" {
    "phong" "reflectance" [ 0.10 0.50 0.20 ] "specularreflectance" [ 0.7 0.7 0.7 ] "float phong" 80
}
Material "bluePhong" {
    "phong" "reflectance" [ 0.10 0.22 0.65 ] "specularreflectance" [ 0.9 0.9 0.9 ] "float phong" 140
}

# ---- geometry ----------------------------------------------------------
Shape "ground" {
    "plane" [ 0 0 0 ]
    "rotate" 1 0 0 -90
    "material" "whiteFloor"
}

# 2/4. Near mesh: coarse, textured, and out of focus.
Shape "nearMesh" {
    "trianglemesh" "meshes/icosphere.obj"
    "translate" -1.6 1.0 2.4
    "scale" 1.0 1.0 1.0
    "material" "stone"
}

# Far mesh: in focus, reflective.
Shape "farMesh" {
    "trianglemesh" "meshes/icosphere.obj"
    "translate" 1.4 1.1 -3.2
    "scale" 1.1 1.1 1.1
    "material" "redMetal"
}

# 3. A perfect mirror sphere next to two rough Phong balls.
Shape "mirrorBall" {
    "sphere" [ 0.7 ]
    "translate" -0.1 0.7 0.4
    "material" "redMetal"
}
Shape "greenBall" {
    "sphere" [ 0.62 ]
    "translate" 2.9 0.62 1.6
    "material" "greenPhong"
}
Shape "blueBall" {
    "sphere" [ 0.5 ]
    "translate" -3.2 0.5 0.6
    "material" "bluePhong"
}

# ---- lights ------------------------------------------------------------
# 1/5. Key: a large bright panel. Its reflection is visible in the mirror ball
# and the red metal mesh.
Light "key" {
    "rectangle" [ -2.2 4.6 3.6   2.2 4.6 3.6 ]
    "radiance" [ 42 40 37 ]
}
# A small, very bright light: nearly the same irradiance as the key but a much
# tighter penumbra. The contrast between this and "key" is the point of the shot.
Light "spec" {
    "rectangle" [ -0.5 3.2 2.2   0.5 3.2 2.2 ]
    "radiance" [ 120 118 112 ]
}
# Cool rim from behind-left.
Light "rim" {
    "rectangle" [ -5.0 1.6 -1.0   -5.0 4.2 -1.0 ]
    "rotate" 0 1 0 90
    "radiance" [ 8 12 22 ]
}
