# aa_spp9 -- the aa_wsrt scene rendered with 9 rays per pixel.
#
# The geometry, the camera and every other setting are identical to
# aa_wsrt.pbrt; only "integer spp" changes. The log records the frame time,
# which is what the report plots against the sample count.

Integrator "whitted" {
    "integer maxdepth" 5
    "integer spp" 9
    "string sampler" "grid"
}

Film "aaStudy" {
    "integer xresolution" 480
    "integer yresolution" 360
}

# ---- camera ----------------------------------------------------------
# normal perspective camera, no depth of field, so the only error in the image is the point sampling
Camera "cam" {
    "lookat" 0 1.7 8.0   0 1.0 0   0 1 0
    "float fov" 40
}

# ---- materials ---------------------------------------------------------
Material "floorMat" {
    "blinnphong" "reflectance" [ 0.72 0.70 0.66 ] "specularreflectance" [ 0.08 0.08 0.08 ] "shininess" 40
    "texture" "diffuse" "textures/checker.ppm"
    "float uscale" 5
    "float vscale" 5
}
Material "redMat"   { "blinnphong" "reflectance" [ 0.70 0.12 0.10 ] "specularreflectance" [ 0.5 0.5 0.5 ] "shininess" 60 }
Material "greenMat" { "blinnphong" "reflectance" [ 0.15 0.55 0.22 ] "specularreflectance" [ 0.5 0.5 0.5 ] "shininess" 60 }
Material "blueMat"  { "blinnphong" "reflectance" [ 0.14 0.30 0.68 ] "specularreflectance" [ 0.6 0.6 0.6 ] "shininess" 90 }
Material "chrome"   { "mirror" "reflectance" [ 0.95 0.96 0.97 ] }
Material "postMat"  { "blinnphong" "reflectance" [ 0.85 0.80 0.55 ] "specularreflectance" [ 0.3 0.3 0.3 ] "shininess" 25 }

# ---- geometry ----------------------------------------------------------
# pbrt's plane is the local z = 0 plane facing +z, so it is rotated to lie flat.
Shape "ground" {
    "plane" [ 0 0 0 ]
    "rotate" 1 0 0 -90
    "material" "floorMat"
}

# Four identical spheres on a diagonal that recedes from the camera: their
# relative sizes in the image are what separates the projections.
Shape "nearSphere"  { "sphere" [ 0.70 ] "translate" -2.2 0.70  3.0 "material" "redMat" }
Shape "midSphere"   { "sphere" [ 0.70 ] "translate" -0.7 0.70  0.5 "material" "greenMat" }
Shape "farSphere"   { "sphere" [ 0.70 ] "translate"  0.8 0.70 -2.0 "material" "blueMat" }
Shape "deepestSph"  { "sphere" [ 0.70 ] "translate"  2.3 0.70 -4.5 "material" "redMat" }

# A mirror ball, so the projected reflection pattern can be compared too.
Shape "mirrorBall" { "sphere" [ 0.9 ] "translate"  2.4 0.9  1.8 "material" "chrome" }

# Vertical triangles give hard silhouettes and a known straight line whose
# convergence (or lack of it) is the classic perspective cue.
Shape "triA" {
    "triangle" [ -4.6 0 -1.0   -3.4 0 -1.0   -4.0 2.4 -1.0 ]
    "material" "postMat"
}
Shape "triB" {
    "triangle" [ -3.4 0 -1.0   -2.9 0 -1.0   -4.0 2.4 -1.0 ]
    "material" "postMat"
}
Shape "triC" {
    "triangle" [  3.6 0 -5.5    4.4 0 -5.5    4.0 1.8 -5.5 ]
    "material" "postMat"
}

# ---- lights ------------------------------------------------------------
Light "keyLight"  { "point" [ -4.0 6.0 5.5 ] "intensity" [ 70 66 60 ] }
Light "fillLight" { "point" [  5.0 4.0 4.0 ] "intensity" [ 22 22 26 ] }

# ---- geometry ----------------------------------------------------------
# Everything here is chosen for hard silhouettes: sphere edges against the
# dark background, thin posts, and a checker floor receding to a grazing
# angle, where the texel footprint becomes smaller than a pixel.
Shape "ground" {
    "plane" [ 0 0 0 ]
    "rotate" 1 0 0 -90
    "material" "floorMat"
}
Shape "ballA" { "sphere" [ 0.80 ] "translate" -2.4 0.80 0.6 "material" "redMat" }
Shape "ballB" { "sphere" [ 0.60 ] "translate" -0.6 0.60 1.6 "material" "blueMat" }
Shape "ballC" { "sphere" [ 1.00 ] "translate"  1.6 1.00 -1.4 "material" "greenMat" }
Shape "chromeBall" { "sphere" [ 0.75 ] "translate"  3.4 0.75 1.4 "material" "chrome" }

# A fence of thin triangles: sixteen near-vertical silhouettes in a small
# part of the frame, the standard aliasing torture test.
Shape "post00" {
    "triangle" [ -4.40 0 -3.6   -4.24 0 -3.6   -4.32 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post01" {
    "triangle" [ -4.06 0 -3.6   -3.90 0 -3.6   -3.98 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post02" {
    "triangle" [ -3.72 0 -3.6   -3.56 0 -3.6   -3.64 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post03" {
    "triangle" [ -3.38 0 -3.6   -3.22 0 -3.6   -3.30 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post04" {
    "triangle" [ -3.04 0 -3.6   -2.88 0 -3.6   -2.96 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post05" {
    "triangle" [ -2.70 0 -3.6   -2.54 0 -3.6   -2.62 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post06" {
    "triangle" [ -2.36 0 -3.6   -2.20 0 -3.6   -2.28 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post07" {
    "triangle" [ -2.02 0 -3.6   -1.86 0 -3.6   -1.94 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post08" {
    "triangle" [ -1.68 0 -3.6   -1.52 0 -3.6   -1.60 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post09" {
    "triangle" [ -1.34 0 -3.6   -1.18 0 -3.6   -1.26 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post10" {
    "triangle" [ -1.00 0 -3.6   -0.84 0 -3.6   -0.92 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post11" {
    "triangle" [ -0.66 0 -3.6   -0.50 0 -3.6   -0.58 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post12" {
    "triangle" [ -0.32 0 -3.6   -0.16 0 -3.6   -0.24 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post13" {
    "triangle" [ 0.02 0 -3.6   0.18 0 -3.6   0.10 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post14" {
    "triangle" [ 0.36 0 -3.6   0.52 0 -3.6   0.44 1.7 -3.6 ]
    "material" "postMat"
}
Shape "post15" {
    "triangle" [ 0.70 0 -3.6   0.86 0 -3.6   0.78 1.7 -3.6 ]
    "material" "postMat"
}

# ---- lights ------------------------------------------------------------
Light "keyLight"  { "point" [ -3.0 5.5 4.0 ] "intensity" [ 80 76 70 ] }
Light "fillLight" { "point" [  4.0 3.5 5.0 ] "intensity" [ 24 24 28 ] }
